{
  "brand": "AVEN Property",
  "version": "1.0.0",
  "date": "2026-08-22",
  "soi": "Calm, by design.",
  "tagline": {
    "hero": "Calm. Clear. Considered.",
    "alternates": ["Calm, by design.", "Managed properly. Guaranteed."],
    "guarantee": "If we don't deliver, you don't pay.",
    "style": "always set straight - never italic"
  },
  "color": {
    "ink":       { "hex": "#1C2B26", "role": "headlines, wordmark, body on light" },
    "pine":      { "hex": "#2E4B3F", "role": "primary brand green - marks, display type, lines" },
    "rain":      { "hex": "#5B7E8C", "role": "accent - the drop in every mark; eyebrows, links, Southern Cross" },
    "sage":      { "hex": "#ADBFAE", "role": "surface/line only - ground lines, chips, dividers. Fails text contrast on light grounds" },
    "sage-text": { "hex": "#6F8579", "role": "the text-safe sage - eyebrows, captions, PROPERTY wordmark line" },
    "cloud":     { "hex": "#F3F5F1", "role": "page ground" },
    "paper":     { "hex": "#FBFCFA", "role": "cards, panels" },
    "mist":      { "hex": "#DFE6E0", "role": "card borders, soft dividers" },
    "hair":      { "hex": "#CCD6CD", "role": "hairline rules" },
    "amber":     { "hex": "#8A6D3B", "role": "internal only - marks an open decision in working documents. Never customer-facing" },
    "body":      { "hex": "#3D4F47", "role": "long-form body copy" },
    "body-deep": { "hex": "#2C3B34", "role": "emphasised body copy" }
  },
  "type": {
    "serif": { "alias": "AVEN Serif", "stack": "\"AVEN Serif\",\"Iowan Old Style\",\"Palatino Linotype\",Palatino,Georgia,serif", "role": "display, wordmark, taglines, pull quotes" },
    "sans":  { "alias": "AVEN Sans",  "stack": "\"AVEN Sans\",\"Avenir Next\",\"Avenir\",\"Segoe UI\",system-ui,sans-serif", "role": "body, UI, captions, eyebrows" },
    "scale": { "display": "clamp(54px,9vw,96px)", "h1": "clamp(30px,4.6vw,42px)", "h2": "clamp(24px,3.6vw,30px)", "body": "17px/1.65", "small": "14px/1.55", "eyebrow": "12px / .22em tracking / uppercase", "caps-label": "11.5px / .2em tracking / uppercase" },
    "wordmark": { "aven": "serif 15px, letter-spacing 7 (on 210px art)", "property": "sans 8.5px, letter-spacing 4.5, sage-text" }
  },
  "line": { "mark-primary": 1.7, "mark-secondary": 1.3, "mark-detail": 0.9, "ground": 1.2, "unit": "px at 210x152 art size" },
  "radius": { "card": 0, "chip": 2 },
  "space": { "sheet-max": "880px", "section": "56px", "card-pad": "22px" }
}
